# Copy to .env and adjust. .env is gitignored — never commit real values.
# Every SB_* var maps to a field on pipeline.config.Config.

# Postgres DSN (Layer 5+). Matches docker-compose defaults.
SB_DATABASE_URL=postgresql://sb:sb@localhost:5432/sb

# Model revision — pin to an exact commit hash once chosen (Layer 2).
SB_MODEL_REVISION=main

# Metric tunables (defaults shown; override only with a reason, Layer 3 / 9).
# SB_RECENCY_LAMBDA=0.5
# SB_LABEL_THRESHOLD=0.15
# SB_TRAJECTORY_DIVISOR=2.0
# SB_BATCH_SIZE=32

# Set by the Docker image, not here — keeps the worker off the network at runtime.
# HF_HUB_OFFLINE=1
